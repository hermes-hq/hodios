{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-ide.com/prompts/schema/v1/vocab.schema.json",
  "title": "Hodios controlled vocabulary",
  "type": "object",
  "required": [
    "schema",
    "facet",
    "values"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "facet": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string"
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "deprecated_by": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}

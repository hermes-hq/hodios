{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-ide.com/prompts/schema/v1/vocab.schema.json",
  "title": "Hodios controlled vocabulary",
  "type": "object",
  "required": [
    "schema",
    "facet",
    "values"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "facet": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string"
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "deprecated_by": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "domain": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "category: the owning domain."
          },
          "scope_note": {
            "type": "string",
            "description": "category: the boundary with neighbouring values."
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "advice_risk": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "uniqueItems": true,
            "description": "category: advice-risk values every entry in it must declare."
          },
          "layout": {
            "enum": [
              "flat",
              "nested"
            ],
            "description": "category: flat (default) or nested."
          },
          "parent": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "subcategory: the parent category."
          },
          "implies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "uniqueItems": true,
            "description": "stack, subject: broader values this one implies."
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "stack, subject: kind of value."
          },
          "detect": {
            "type": "object",
            "additionalProperties": false,
            "description": "stack: on-device project detection hints for Hermes.",
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "deps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]+:[^\\s]+$"
                },
                "uniqueItems": true
              }
            }
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "role: picker group."
          },
          "onet": {
            "type": "string",
            "pattern": "^\\d{2}-\\d{4}(\\.\\d{2})?$",
            "description": "role: O*NET-SOC code."
          },
          "partials": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*$"
            },
            "uniqueItems": true,
            "description": "advice-risk: guardrail partials an entry with this value must include."
          }
        }
      }
    }
  }
}

{
  "name": "@hermes-hq/hodios-schema",
  "version": "0.1.0",
  "description": "JSON Schemas, TypeScript types and a validator for Hodios library entries.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entry.schema.json": "./schemas/entry.schema.json",
    "./evals.schema.json": "./schemas/evals.schema.json",
    "./vocab.schema.json": "./schemas/vocab.schema.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "prepack": "node -e \"require('node:fs').cpSync('../../schema','schemas',{recursive:true})\""
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermes-hq/hodios.git",
    "directory": "packages/schema"
  },
  "homepage": "https://hermes-ide.com/prompts",
  "bugs": "https://github.com/hermes-hq/hodios/issues",
  "keywords": [
    "hodios",
    "prompts",
    "json-schema",
    "agent-skills"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

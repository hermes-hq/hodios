{
  "name": "@hermes-hq/hodios-core",
  "version": "0.1.0",
  "description": "Isomorphic core for Hodios: parse, validate, compile entries to every AI tool, and search the catalog index.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compile": {
      "types": "./dist/compile/index.d.ts",
      "import": "./dist/compile/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@hermes-hq/hodios-schema": "0.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermes-hq/hodios.git",
    "directory": "packages/core"
  },
  "homepage": "https://hermes-ide.com/prompts",
  "bugs": "https://github.com/hermes-hq/hodios/issues",
  "keywords": [
    "hodios",
    "prompts",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
